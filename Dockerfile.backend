FROM node:20-slim AS build

ARG DB_URL
ENV DB_URL=${DB_URL}

# ARG MULTER_UPLOAD_DIR: "/app/uploads"
# ENV MULTER_UPLOAD_DIR="/app/uploads"

# ARG FILE_STORAGE_DIR: "/app/files"
# ENV FILE_STORAGE_DIR="/app/files"

# RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# RUN git config --global user.email "temp@example.com" && git config --global user.name "Temp User"
# Build stage

WORKDIR /app
COPY ./server/package.json ./
RUN npm install
COPY ./server ./server
RUN npm run build

# Production stage
FROM node:20-slim
WORKDIR /app
COPY --from=build /app/dist ./
COPY --from=build /app/node_modules ./node_modules
EXPOSE 4931
CMD ["node", "index.js"]
